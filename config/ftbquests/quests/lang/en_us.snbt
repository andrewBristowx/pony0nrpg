	quest.604171E7AD5F136E.quest_desc: [
		"Create mueve el mundo con fuerza rotatoria. Esta rama opcional te enseña lo mínimo; el capítulo 4 trata Create a fondo."
		"Empieza con una aleación de andesita: andesita + hierro (o pepitas de hierro)."
	]
