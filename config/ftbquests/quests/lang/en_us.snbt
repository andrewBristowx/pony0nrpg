	quest.57C84769B9A5FB8F.title: "Coliseo"
	quest.5AC03FC7AF1A0F16.quest_desc: [
		"Los diamantes aparecen muy abajo, cerca de la capa Y -58. Lleva antorchas, comida y un pico de hierro, y ten cuidado con la lava."
