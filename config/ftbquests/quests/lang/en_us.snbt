	quest.613EB86C5C470D5C.title: "Dragón de rayo"
	quest.661472E3C58175D2.quest_desc: [
		"Los procesadores se fabrican con moldes en un inscriptor. Necesitas lógica, cálculo e ingeniería."
		"Un mecanismo de precisión de Create viene muy bien en esta etapa."
	]
	quest.661472E3C58175D2.quest_subtitle: "El corazón de AE2"
	quest.661472E3C58175D2.title: "Procesadores"
	quest.68C1A8BC88D5C2E1.quest_desc: ["Los zombis rodean el pueblo. Elimina 30."]
	quest.68C1A8BC88D5C2E1.quest_subtitle: "Novato"
	quest.68C1A8BC88D5C2E1.title: "Encargo: zombis"
	quest.69AE17FC4E72B712.quest_desc: [
		"Aquí están los enemigos más poderosos del mundo. Se enfrentan en grupo, con buen equipo, pociones, comida y un plan."
