	quest.FF6561684F886B64.title: "Cocinero: práctica"
	quest.FFCF9B720D72B757.quest_desc: ["Las waystones te permiten teletransportarte entre las que hayas activado. Colocar una junto a tu base te evitará muchos viajes."]
