	quest.FC83CEEB4EC50B37.quest_desc: ["Abre el árbol de habilidades (&6K&r) y gasta tu primer punto en el primer nodo de una clase. Las misiones siguientes se completan solas según la clase que elijas."]
	quest.FC83CEEB4EC50B37.quest_subtitle: "Clase"
	quest.FC83CEEB4EC50B37.title: "Elige tu camino"
	quest.FCE9D77E5744EA27.quest_desc: ["Los conectores unen máquinas con cable. Cuidado con la distancia y con la pérdida por hilo fino."]
	quest.FCE9D77E5744EA27.quest_subtitle: "Transporte de energía"
	quest.FCE9D77E5744EA27.title: "Cables y conectores"
	quest.FE1C55A4EEDEA50A.quest_desc: ["La esencia arcana se obtiene de enemigos mágicos y estructuras. Es la base de casi todo en Iron's Spells."]
	quest.FE1C55A4EEDEA50A.quest_subtitle: "El material de la magia"
	quest.FE1C55A4EEDEA50A.title: "Esencia arcana"
	quest.FE538FA4FBF014EF.quest_desc: ["Los bastiones tienen piglins y mucho oro. Ponte una pieza de oro para que no se enfaden."]
	quest.FE538FA4FBF014EF.quest_subtitle: "Piglins"
	quest.FE538FA4FBF014EF.title: "Bastión"
	quest.FF6561684F886B64.quest_desc: ["Cocina carne y pescado, y prepara comida variada."]
