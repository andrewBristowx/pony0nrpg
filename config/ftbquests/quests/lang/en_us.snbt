	quest.5D3FFEF92F1173B2.quest_subtitle: "El jefe final"
	quest.5D3FFEF92F1173B2.title: "El dragón del End"
	quest.5E89FB767BB1E9C7.quest_desc: [
		"Sigue subiendo en tu clase hasta &6Fundamentos VI&r: eso te da el Tier II y abre equipo mejor."
